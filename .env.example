# Copy this file to .env.local for local development. Never commit real
# secrets — .env* is gitignored except this example file.

# --- Database ---------------------------------------------------------------
# Local dev default assumes a local Postgres with a `coleman_storybook`
# database and the default postgres/postgres credentials. In production this
# points at your managed Postgres (e.g. Supabase connection string).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/coleman_storybook"

# --- Sessions / auth ----------------------------------------------------------
# 32+ byte random secret used to sign admin session cookies (HS256 JWT via
# `jose`). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# --- Media storage ------------------------------------------------------------
# V1 dev/local adapter stores files on disk under STORAGE_LOCAL_DIR and serves
# them through a signed, time-limited route handler (see
# src/lib/storage/local-adapter.ts). STORAGE_SIGNING_SECRET signs those URLs.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/media"
STORAGE_SIGNING_SECRET="replace-with-a-real-random-secret"

# Original production adapter (chosen per docs/decision-log.md DL-008 —
# Vercel + Supabase for both Postgres and Storage). Verified against a live
# bucket 2026-08-11 — see src/lib/storage/supabase-adapter.ts's header
# comment for what the fix was (bare PUT against the signed-upload URL
# doesn't work; needs multipart/form-data plus an `apikey` header). Left
# working and available as a rollback path even though "drive" (below) is
# the current production choice.
# STORAGE_DRIVER="supabase"
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="coleman-storybook-media"
# Public/anon key — safe to expose to the browser (sent as the `apikey`
# header on the upload PUT); grants no storage access on its own.
# SUPABASE_ANON_KEY=""

# Current production adapter as of 2026-08-11 (owner decision: cheaper
# storage at the owner's existing Google One tier, plus direct backend
# access for future transcription scripts — see
# src/lib/storage/google-drive-adapter.ts's header comment and
# docs/google-drive-setup.md for the required one-time Google Cloud Console
# setup). All 4 values below come from that setup; none of them are
# guessable/derivable from each other.
# STORAGE_DRIVER="drive"
# GOOGLE_DRIVE_CLIENT_ID=""
# GOOGLE_DRIVE_CLIENT_SECRET=""
# A refresh token for a single OAuth app that requests ONLY the
# drive.file scope against the owner's own Google account — grants access
# exclusively to files this app creates, never the rest of the owner's
# Drive. Must be minted with the OAuth consent screen in "In production"
# publishing status, not "Testing" — Testing-status refresh tokens silently
# expire after 7 days (see docs/google-drive-setup.md).
# GOOGLE_DRIVE_REFRESH_TOKEN=""
# Drive folder ID (from the folder's URL) that holds every file this app
# uploads. Reads/writes/deletes are scoped to files by name within this one
# folder — see google-drive-adapter.ts.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# --- Transcription provider ---------------------------------------------------
# "fake" is a deterministic, clearly-labeled local provider used for dev/test
# so the pipeline can be demonstrated without any paid API calls or a key.
#
# In PRODUCTION for the initial POC pilot, use "none" instead of "fake"
# (owner decision, docs/decision-log.md DL-009: hold off on paid
# transcription/AI to keep the POC at zero marginal cost). "none" fully
# disables the processing pipeline for real submissions so admins review
# raw video directly — it deliberately does NOT fall back to "fake", which
# would otherwise generate a fabricated placeholder transcript next to a
# real alumnus's real story. See src/lib/providers/transcription/index.ts.
# Vendor recommendation for when this is revisited post-POC: docs/deployment.md.
TRANSCRIPTION_PROVIDER="fake"
# TRANSCRIPTION_PROVIDER="none"   # <- use this in production for the POC
# TRANSCRIPTION_API_KEY=""

# --- AI story analysis provider -----------------------------------------------
# Only ever invoked if transcription actually ran, so no separate "none" is
# needed here — leaving this as "fake" is harmless when
# TRANSCRIPTION_PROVIDER=none, since no analysis job is ever enqueued.
AI_ANALYSIS_PROVIDER="fake"
# AI_ANALYSIS_API_KEY=""

# --- Processing job runner -----------------------------------------------------
# Shared secret required on the header `x-cron-secret` for
# POST /api/jobs/process, mimicking how Vercel Cron (or any external
# scheduler) would authenticate in production.
CRON_SECRET="replace-with-a-real-random-secret"

# --- Email (contributor identity verification) ---------------------------------
# "console" (default) logs the OTP code to the server console instead of
# sending a real email — useful for local dev/testing without a Resend
# account. Use "resend" in production. See docs/resend-setup.md.
EMAIL_PROVIDER="console"
# RESEND_API_KEY=""
# Must be a verified sender on your Resend account/domain — see
# docs/resend-setup.md.
# RESEND_FROM_EMAIL="Coleman Storybook <noreply@yourdomain.org>"

# --- App/org config -------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
